# Server Configuration
NODE_ENV=production
PORT=3000

# Database Configuration
MONGODB_URI=mongodb+srv://your-production-username:your-production-password@your-cluster.mongodb.net/sunlit-garden?retryWrites=true&w=majority

# Authentication
JWT_SECRET=your-strong-production-secret-key
JWT_EXPIRATION_TIME=24h

# Security
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:19006,http://localhost:8081

# Rate Limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=50

# Logging and Monitoring (optional integrations)
# SENTRY_DSN=your-sentry-dsn
# NEW_RELIC_LICENSE_KEY=your-new-relic-key

# GraphQL Settings
GRAPHQL_PLAYGROUND=false
GRAPHQL_DEBUG=false
GRAPHQL_INTROSPECTION=false

# Additional Security Settings
SECURE_COOKIES=true
CORS_CREDENTIALS=true
    